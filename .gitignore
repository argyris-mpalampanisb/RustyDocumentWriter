# ---- Rust / Cargo ----
/target/
**/*.rs.bk
*.pdb
# Cargo.lock is intentionally committed (this is an application; CI builds with --locked).
# .cargo/config.toml is committed (static CRT for portable Windows builds) — but never credentials:
.cargo/credentials
.cargo/credentials.toml

# ---- Profiling / coverage output ----
*.profraw
*.profdata
perf.data*
flamegraph.svg
/coverage/
lcov.info

# ---- RustyDocumentWriter build & tool output ----
/dist/
/render-out/
testdata/render/
*.rdw-tmp
# Scratch files written while comparing against the reference (tools/compare.py)
testdata/reference-dump.tsv
testdata/rdw-dump.tsv

# ---- Generated by cargo-about in CI (see about.toml) ----
/THIRD-PARTY-LICENSES.html

# ---- Python (tools/) ----
__pycache__/
*.py[cod]
.venv/

# ---- Document editor lock & temp files ----
~$*.doc
~$*.docx
~$*.docm
~$*.dotx
~$*.dotm
~$*.rtf
~WRL*.tmp

# ---- Editors & IDEs ----
.vs/
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.fleet/
.zed/
*.sublime-workspace

# ---- Claude Code local settings ----
.claude/settings.local.json

# ---- Merge / patch leftovers & logs ----
*.orig
*.rej
*.log

# ---- OS files ----
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
__MACOSX/
# Linux
.directory
.Trash-*
.nfs*

# ---- Secrets (never commit) ----
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# ---- Personal notes (kept local) ----
/github commands cheat sheet.md
