<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>RustyDocumentWriter — Third-party licenses</title>
<style>
  body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; max-width: 920px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; background: #fff; line-height: 1.5; }
  h1 { margin-bottom: .2rem; }
  .intro { color: #59636e; }
  h2 { margin-top: 2.5rem; border-bottom: 1px solid #d1d9e0; padding-bottom: .3rem; }
  ul.overview { columns: 2; }
  ul.crates { font-size: .92rem; color: #59636e; }
  pre { white-space: pre-wrap; background: #f6f8fa; border: 1px solid #d1d9e0; border-radius: 6px; padding: 1rem; font-size: .82rem; }
  @media (prefers-color-scheme: dark) {
    body { background: #0d1117; color: #e6edf3; }
    .intro, ul.crates { color: #9198a1; }
    pre { background: #161b22; border-color: #30363d; }
    h2 { border-color: #30363d; }
  }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p class="intro">RustyDocumentWriter is licensed under the MIT License. It is built with the open-source
components listed below, each distributed under its own license. The bundled
Liberation Sans fonts are licensed under the SIL Open Font License 1.1
(see <code>LICENSE-LiberationFonts-OFL.txt</code>).</p>

<h2>Overview</h2>
<ul class="overview">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="crates">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
